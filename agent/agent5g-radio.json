{
  "role": "radio",
  "listen": "192.168.1.31",
  "port": 9443,
  "cert": "/etc/agent5g/certs/agent-radio.crt",
  "key": "/etc/agent5g/certs/agent-radio.key",
  "ca": "/etc/agent5g/certs/ca.crt",
  "allowed_client_cn": [
    "panel5g"
  ],
  "project_dir": "/home/core5g/Escritorio/5g/ocudu/docker",
  "env_file": ".env",
  "compose_files": [
    "docker-compose.yml"
  ],
  "compose_project": "docker",
  "editable_keys": {
    "DL_ARFCN": "^[0-9]{5,7}$",
    "BAND": "^[0-9]{1,3}$",
    "BANDWIDTH_MHZ": "^(5|10|15|20|25|30|40|50|60|80|100)$",
    "SCS": "^(15|30|60)$",
    "SRATE": "^[0-9]{1,3}(\\.[0-9]{1,2})?$",
    "TX_GAIN": "^[0-9]{1,2}$",
    "RX_GAIN": "^[0-9]{1,2}$",
    "PCI": "^[0-9]{1,4}$",
    "TX_ANTENA": "^(1|2)$",
    "RX_ANTENA": "^(1|2)$",
    "PLMN_1": "^[0-9]{5,6}$",
    "TAC": "^[0-9]{1,8}$"
  },
  "containers": [
    "ocudu_gnb"
  ],
  "services": [
    "gnb"
  ],
  "log_files": {
    "gnb.log": "/var/lib/docker/volumes/docker_gnb-storage/_data/gnb.log"
  },
  "backup_dir": "/var/lib/agent5g/backups",
  "audit_log": "/var/lib/agent5g/audit.log",
  "docker_bin": "/usr/bin/docker",
  "max_log_lines": 2000,
  "max_backups": 50,
  "apply_timeout": 300
}
