{
  "role": "upf",
  "name": "UPF upf1",
  "listen": null,
  "core": "192.168.1.100",
  "core_port": 9544,
  "cert": "/etc/agent5g-upf/certs/agent-upf.crt",
  "key": "/etc/agent5g-upf/certs/agent-upf.key",
