[Unit]
Description=agent5g - agent mTLS per al panell 5G
After=network-online.target docker.service
Wants=network-online.target docker.service
# Sempre en marxa: sense límit de reintents, i no s'atura si Docker o el panell es reinicien
# (Wants en lloc de Requires: un reinici de Docker no arrossega l'agent).
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/agent5g/agent5g.py -c /etc/agent5g/agent5g.json
Restart=always
RestartSec=3
# Necessita root (o grup docker, que és equivalent) per parlar amb Docker.
# La resta del sistema queda en només lectura.
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/agent5g
# Afegeix aquí la carpeta del projecte (on hi ha el .env), p. ex.:
# ReadWritePaths=/home/core5g/Escritorio/5g/ocudu/docker
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
